# =============================================================================
# VertexLearn AI — LOCAL DEVELOPMENT settings (optional)
#
# You don't need this file to run locally: docker-compose.override.yml has safe dev defaults.
# Copy it only to change something:   copy .env.example .env      (Windows)
#                                     cp .env.example .env        (macOS/Linux)
# docker compose reads .env automatically. Never commit your real .env.
#
# For staging/production use .env.production.example + scripts/generate-secrets.mjs instead.
# =============================================================================

# ---- AI: Google Cloud Vertex AI (optional) ------------------------------------
# Leave GOOGLE_CLOUD_PROJECT empty to run the AI tutor in clearly-labelled DEMO mode (no API calls).
# Credentials are Google Application Default Credentials, mounted read-only into the ai-service
# container only — never sent to the browser or the Node backend. See README → "Turning on real AI".
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Folder on THIS computer holding the credentials file, and the file's name. Keep it outside the project.
#   gcloud login:     GCP_CREDENTIALS_DIR=C:/Users/<you>/AppData/Roaming/gcloud  (macOS/Linux: ~/.config/gcloud)
#                     GCP_CREDENTIALS_FILE=application_default_credentials.json
#   service account:  GCP_CREDENTIALS_DIR=<folder>   GCP_CREDENTIALS_FILE=<key>.json
# GCP_CREDENTIALS_DIR=
# GCP_CREDENTIALS_FILE=application_default_credentials.json
# Optional tuning
# VERTEX_THINKING_BUDGET=          # tokens the model may "think"; empty = model default
# VERTEX_FALLBACK_TO_DEMO=true     # labelled demo answers if Vertex AI fails after retries
# VERTEX_TIMEOUT_SECONDS=45        # per attempt
# VERTEX_TOTAL_TIMEOUT_SECONDS=100 # all retries together (the backend waits up to 120 s)
# VERTEX_MAX_ATTEMPTS=3

# ---- Development secrets ------------------------------------------------------
# These defaults are public (they are in this repository). That's fine on your own computer;
# the apps REFUSE to start with them when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
FILE_URL_SECRET=dev-file-url-secret-change-me
AI_SERVICE_KEY=dev-internal-ai-key
POSTGRES_PASSWORD=vertex
S3_ACCESS_KEY=vertexlearn
S3_SECRET_KEY=vertexlearn-secret

# ---- App ----------------------------------------------------------------------
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# HTTP_PORT=8080          # change if port 8080 is busy on your computer
# LOG_LEVEL=info
# AUTH_RATE_LIMIT=10      # login/register attempts per minute per IP (PRD 8.9)

# ---- Backend-only settings when running `npm run dev` outside Docker ----------
# (inside Docker these are set by the compose files)
# DATABASE_URL=postgresql://vertex:vertex@localhost:5432/vertexlearn
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:8333
# SMTP_HOST=localhost
# SMTP_PORT=1025
# AI_SERVICE_URL=http://localhost:8000
