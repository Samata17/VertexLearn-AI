# =============================================================================
# VertexLearn AI — STAGING / PRODUCTION settings (NON-secret values only)
#
#   copy .env.production.example .env.production   (then edit)
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --wait
#
# Secrets (passwords, JWT keys, API keys) do NOT go here. They live in ./secrets/, created by
#   node scripts/generate-secrets.mjs
# =============================================================================

# ---- Public address ---------------------------------------------------------
# The HTTPS address users open. TLS is terminated in front of the gateway (load balancer / Caddy / Traefik).
APP_URL=https://learn.example.com
CORS_ORIGINS=https://learn.example.com
HTTP_BIND=127.0.0.1        # only the TLS proxy on this machine can reach the gateway; use 0.0.0.0 behind a cloud LB
HTTP_PORT=8080
# nginx resolves the real client IP from your proxy's X-Forwarded-For header, so the API trusts one hop.
TRUST_PROXY=1

# ---- Images (PRD 14.5: tag = Git commit SHA, rollback = deploy an older tag) ----
REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=latest

# ---- Email (required: password resets, grades, announcements) ---------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=apikey
MAIL_FROM=VertexLearn AI <no-reply@learn.example.com>
# The SMTP password goes in secrets/smtp_pass

# ---- AI: Google Cloud Vertex AI -----------------------------------------------
# Empty GOOGLE_CLOUD_PROJECT = labelled demo mode.
# Credentials: on Google Cloud the attached service account is used (leave secrets/gcp_service_account.json
# empty); elsewhere put a service-account key with the "Vertex AI User" role in that file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash

# ---- Object storage ---------------------------------------------------------
# Bundled SeaweedFS (default) — or AWS S3:
#   S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
#   S3_REGION=ap-south-1
#   S3_FORCE_PATH_STYLE=false
# and put the IAM secret key in secrets/s3_secret_key
S3_BUCKET=vertexlearn
S3_ACCESS_KEY=vertexlearn

# ---- Staging only -----------------------------------------------------------
# true loads the demo accounts (shared public password!) so smoke tests can log in. NEVER in production.
SEED_DEMO_DATA=false

# ---- Resource limits (PRD 14.1: staging = same config, smaller limits) -------
# BACKEND_MEMORY=1g
# WORKER_MEMORY=512m
# AI_SERVICE_MEMORY=2g
# POSTGRES_MEMORY=2g
# REDIS_MEMORY=512m
